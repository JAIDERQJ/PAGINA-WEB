# Base de datos (gratis en https://neon.tech — plan gratuito permanente)
DATABASE_URL="postgresql://usuario:password@host/nombre_bd?sslmode=require"

# Contraseña única para entrar al panel /admin. Cámbiala por algo fuerte.
ADMIN_PASSWORD="cambia-esto-por-una-clave-segura"

# URL pública de tu sitio (sin barra final). En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Wompi (pasarela de pagos) — obtén estas llaves en https://comercios.wompi.co
# Panel > Desarrolladores > Llaves API
WOMPI_PUBLIC_KEY="pub_test_xxxxxxxxxxxxxxxx"
WOMPI_INTEGRITY_SECRET="test_integrity_xxxxxxxxxxxxxxxx"
# Opcional pero recomendado: para que el webhook verifique que el evento viene de Wompi
WOMPI_EVENTS_SECRET="test_events_xxxxxxxxxxxxxxxx"
